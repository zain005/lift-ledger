          "ref": "hip-thrust",
          "name": "Hip Thrust",
          "sets": 3,
          "reps": "8–10",
          "type": "compound",
          "cue": "Chin tucked, ribs down; drive through your heels and squeeze your glutes hard at the top.",
          "cue_ar": "الذقن للداخل والأضلاع للأسفل؛ ادفع بكعبيك واعصر أردافك بقوة في الأعلى.",
          "alts": [
            "Machine hip thrust",
            "Glute bridge",
            "Cable pull-through"
          ],
          "alts_ar": [
            "دفع الورك على الجهاز",
            "جسر الأرداف",
            "السحب بين الرجلين بالكيبل"
