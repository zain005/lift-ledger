          "ref": "leg-press",
          "name": "Leg Press",
          "sets": 3,
          "reps": "8–10",
          "type": "compound",
          "cue": "Lower until your hips are about to tuck under, then press without locking your knees hard.",
          "alts": [
            "Hack squat",
            "Smith machine squat",
            "Goblet squat"
          ],
          "alts_ar": [
            "الهاك سكوات",
            "السكوات على جهاز سميث",
            "سكوات الكأس (جوبلت)"
