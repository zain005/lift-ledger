{
  "format": 2,
  "id": "upper-lower-4",
  "name": "Upper / Lower",
  "name_ar": "علوي / سفلي",
  "description": "4 days a week. Two upper and two lower sessions, about 8–12 hard sets per muscle a week.",
  "description_ar": "4 أيام في الأسبوع. حصتان للجزء العلوي وحصتان للسفلي، نحو 8–12 مجموعة شاقة لكل عضلة أسبوعيًا.",
  "schedule": "Upper, Lower, rest, Upper, Lower, then 2 rest days.",
  "schedule_ar": "علوي، سفلي، راحة، علوي، سفلي، ثم يوما راحة.",
  "weeks": 8,
  "phases": [
    {
      "name": "Foundation",
      "name_ar": "التأسيس",
      "weeks": [
        1,
        4
      ],
      "rpe": {
        "heavy": "6 / 7",
        "compound": "7 / 8",
        "isolation": "8 / 9"
      }
    },
    {
      "name": "Build",
      "name_ar": "البناء",
      "weeks": [
        5,
        8
      ],
      "rpe": {
        "heavy": "7 / 8",
        "compound": "7–8 / 9",
        "isolation": "9 / 10"
      }
    }
  ],
  "days": [
    {
      "id": "ul-a",
      "name": "Upper A",
      "name_ar": "علوي أ",
      "short": "Upper",
      "short_ar": "علوي",
      "exercises": [
        {
          "id": "ul-a1",
          "ref": "bench-press",
          "name": "Barbell Bench Press",
          "sets": 3,
          "reps": "6–8",
          "type": "compound",
          "cue": "Shoulder blades pulled back, feet planted; lower to your lower chest and press up and slightly back.",
          "alts": [
            "Dumbbell bench press",
            "Machine chest press",
            "Smith machine bench press"
          ],
          "alts_ar": [
            "ضغط الصدر بالدمبل",
            "ضغط الصدر على الجهاز",
            "ضغط البنش على جهاز سميث"
          ]
        },
        {
          "id": "ul-a2",
          "ref": "chest-supported-row",
          "name": "Chest-Supported Row",
          "sets": 3,
          "reps": "8–10",
          "type": "compound",
          "cue": "Chest on the pad; pull your elbows back and squeeze your upper back without shrugging.",
          "alts": [
            "Seated cable row",
            "Dumbbell row",
            "Machine row"
          ],
          "alts_ar": [
            "التجديف بالكيبل جالسًا",
            "التجديف بالدمبل بذراع واحدة",
            "التجديف على الجهاز"
          ]
        },
        {
          "id": "ul-a3",
          "ref": "seated-db-shoulder-press",
          "name": "Seated Dumbbell Shoulder Press",
          "sets": 2,
          "reps": "8–10",
          "type": "compound",
          "cue": "Sit tall with your back on the pad; lower the dumbbells to ear level and press overhead.",
          "alts": [
            "Machine shoulder press",
            "Standing overhead press",
            "Arnold press"
          ],
          "alts_ar": [
            "ضغط الكتف على الجهاز",
            "الضغط العسكري واقفًا",
            "ضغط أرنولد"
          ]
        },
        {
          "id": "ul-a4",
          "ref": "lat-pulldown",
          "name": "Lat Pulldown",
          "sets": 3,
          "reps": "8–10",
          "type": "compound",
          "cue": "Lean back slightly and pull your elbows down toward your hips; let your arms fully extend at the top.",
          "alts": [
            "Pull-up",
            "Assisted pull-up",
            "Single-arm cable pulldown"
          ],
          "alts_ar": [
            "العقلة",
            "العقلة بالمساعدة",
            "السحب بالكيبل بذراع واحدة"
          ]
        },
        {
          "id": "ul-a5",
          "ref": "cable-lateral-raise",
          "name": "Cable Lateral Raise",
          "sets": 3,
          "reps": "12–15",
          "type": "isolation",
          "cue": "Cable at hand height behind you; raise your arm out to the side until it's level with your shoulder.",
          "alts": [
            "Dumbbell lateral raise",
            "Machine lateral raise"
          ],
          "alts_ar": [
            "الرفع الجانبي بالدمبل",
            "الرفع الجانبي على الجهاز"
          ]
        },
        {
          "id": "ul-a6",
          "ref": "incline-db-curl",
          "name": "Incline Dumbbell Curl",
          "sets": 2,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Arms hanging behind your body on an incline bench; curl without moving your elbows forward.",
          "alts": [
            "Cable curl",
            "Dumbbell curl"
          ],
          "alts_ar": [
            "ثني الذراعين بالكيبل",
            "ثني الذراعين بالدمبل"
          ]
        },
        {
          "id": "ul-a7",
          "ref": "triceps-pressdown",
          "name": "Triceps Pressdown",
          "sets": 2,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Elbows pinned to your sides; push down until your arms are straight and pause.",
          "alts": [
            "Rope pressdown",
            "Dip machine"
          ],
          "alts_ar": [
            "دفع الترايسبس بالحبل",
            "المتوازي على الجهاز"
          ]
        }
      ]
    },
    {
      "id": "ul-b",
      "name": "Lower A",
      "name_ar": "سفلي أ",
      "short": "Lower",
      "short_ar": "سفلي",
      "exercises": [
        {
          "id": "ul-b1",
          "ref": "back-squat",
          "name": "Back Squat",
          "sets": 3,
          "reps": "6–8",
          "type": "heavy",
          "cue": "Brace before each rep, sit down between your hips and keep your knees tracking over your toes.",
          "alts": [
            "Hack squat",
            "Smith machine squat",
            "Leg press"
          ],
          "alts_ar": [
            "الهاك سكوات",
            "السكوات على جهاز سميث",
            "ضغط الأرجل"
          ]
        },
        {
          "id": "ul-b2",
          "ref": "romanian-deadlift",
          "name": "Romanian Deadlift",
          "sets": 3,
          "reps": "8–10",
          "type": "heavy",
          "cue": "Push your hips back with a slight knee bend and a flat back; stop when your hamstrings are fully stretched.",
          "alts": [
            "Dumbbell Romanian deadlift",
            "Stiff-leg deadlift",
            "45° back extension"
          ],
          "alts_ar": [
            "الرفعة الرومانية بالدمبل",
            "الرفعة بأرجل مستقيمة",
            "تمديد الظهر 45°"
          ]
        },
        {
          "id": "ul-b3",
          "ref": "leg-extension",
          "name": "Leg Extension",
          "sets": 2,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Pause briefly at the top and lower slowly; keep your hips down on the seat.",
          "alts": [
            "Sissy squat",
            "Reverse Nordic",
            "Goblet squat"
          ],
          "alts_ar": [
            "السيسي سكوات",
            "النوردي العكسي",
            "سكوات الكأس (جوبلت)"
          ]
        },
        {
          "id": "ul-b4",
          "ref": "seated-leg-curl",
          "name": "Seated Leg Curl",
          "sets": 3,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Lean your chest forward a little for more stretch, curl hard and control the way back.",
          "alts": [
            "Lying leg curl",
            "Nordic ham curl"
          ],
          "alts_ar": [
            "ثني الأرجل مستلقيًا",
            "الثني النوردي"
          ]
        },
        {
          "id": "ul-b5",
          "ref": "standing-calf-raise",
          "name": "Standing Calf Raise",
          "sets": 3,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Pause in the deep stretch at the bottom, then rise as high as you can. No bouncing.",
          "alts": [
            "Leg press calf raise",
            "Seated calf raise",
            "Single-leg calf raise"
          ],
          "alts_ar": [
            "رفع السمانة على جهاز ضغط الأرجل",
            "رفع السمانة جالسًا",
            "رفع السمانة برجل واحدة"
          ]
        },
        {
          "id": "ul-b6",
          "ref": "hanging-leg-raise",
          "name": "Hanging Leg Raise",
          "sets": 3,
          "reps": "10–15",
          "type": "isolation",
          "cue": "Curl your pelvis up toward your ribs instead of just lifting your legs. Log 0 for bodyweight.",
          "cue_ar": "ارفع حوضك نحو أضلاعك بدلًا من رفع ساقيك فقط. سجّل 0 لوزن الجسم.",
          "alts": [
            "Captain's chair leg raise",
            "Lying leg raise",
            "Cable crunch"
          ],
          "alts_ar": [
            "رفع الأرجل على كرسي الكابتن",
            "رفع الأرجل مستلقيًا",
            "الطحن بالكيبل"
          ]
        }
      ]
    },
    {
