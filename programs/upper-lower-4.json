          "ref": "cable-crunch",
          "name": "Cable Crunch",
          "sets": 3,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Round your spine to bring your ribs toward your hips, rather than bending at the hips.",
          "alts": [
            "Machine crunch",
            "Weighted crunch"
          ],
          "alts_ar": [
            "الطحن على الجهاز",
            "الطحن بالوزن"
          ]
        }
