      "name": "Upper B",
      "name_ar": "علوي ب",
      "short": "Upper",
      "short_ar": "علوي",
      "exercises": [
        {
          "id": "ul-c1",
          "ref": "incline-db-press",
          "name": "Incline Dumbbell Press",
          "sets": 3,
          "reps": "8–10",
          "type": "compound",
          "cue": "Bench at 30–45°. Lower under control to a stretch, then press up over your upper chest.",
          "alts": [
            "Incline barbell press",
            "Incline machine press",
            "Incline Smith press"
          ],
          "alts_ar": [
            "ضغط البنش المائل بالبار",
            "ضغط الصدر المائل على الجهاز",
            "ضغط الصدر المائل على جهاز سميث"
          ]
        },
        {
          "id": "ul-c2",
          "ref": "single-arm-cable-row",
          "name": "Single-Arm Cable Row",
          "sets": 3,
          "reps": "10–12",
          "type": "compound",
          "cue": "Reach forward for a full stretch, then pull your elbow back toward your hip.",
          "alts": [
            "Dumbbell row",
            "Seated cable row",
            "Chest-supported row"
          ],
          "alts_ar": [
            "التجديف بالدمبل بذراع واحدة",
            "التجديف بالكيبل جالسًا",
            "التجديف على الجهاز مع إسناد الصدر"
          ]
        },
        {
          "id": "ul-c3",
          "ref": "pull-up",
          "name": "Pull-Up",
          "sets": 3,
          "reps": "6–10",
          "type": "compound",
          "cue": "Start from a dead hang and pull your chest toward the bar. Use assistance if you can't hit the reps.",
          "cue_ar": "ابدأ من تعلّق كامل واسحب صدرك نحو البار. استخدم المساعدة إن لم تصل إلى التكرارات.",
          "alts": [
            "Assisted pull-up",
            "Lat pulldown"
          ],
          "alts_ar": [
            "العقلة بالمساعدة",
            "السحب الأمامي"
          ]
        },
        {
          "id": "ul-c4",
          "ref": "pec-deck",
          "name": "Pec Deck",
          "sets": 2,
          "reps": "12–15",
          "type": "isolation",
          "cue": "Keep a slight bend in your elbows and bring the handles together without shrugging.",
          "alts": [
            "Cable fly",
            "Dumbbell fly"
          ],
          "alts_ar": [
            "تفتيح الصدر بالكيبل",
            "تفتيح الصدر بالدمبل"
          ]
        },
        {
          "id": "ul-c5",
          "ref": "reverse-pec-deck",
          "name": "Reverse Pec Deck",
          "sets": 2,
          "reps": "12–15",
          "type": "isolation",
          "cue": "Arms nearly straight; sweep back with your rear delts without squeezing your shoulder blades hard.",
          "alts": [
            "Reverse cable fly",
            "Face pull",
            "Bent-over dumbbell reverse fly"
          ],
          "alts_ar": [
            "التفتيح العكسي بالكيبل",
            "سحب الحبل للوجه",
            "التفتيح العكسي بالدمبل منحنيًا"
          ]
        },
        {
          "id": "ul-c6",
          "ref": "overhead-cable-extension",
          "name": "Overhead Cable Triceps Extension",
          "sets": 2,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Face away from the cable and let your hands travel well behind your head before extending.",
          "alts": [
            "Overhead dumbbell extension",
            "EZ-bar skull crusher"
          ],
          "alts_ar": [
            "تمديد الترايسبس فوق الرأس بالدمبل",
            "كسارة الجمجمة بالبار المتعرج"
          ]
        },
        {
          "id": "ul-c7",
          "ref": "hammer-curl",
          "name": "Hammer Curl",
          "sets": 2,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Palms facing each other; curl without letting your upper arm swing.",
          "alts": [
            "Rope cable hammer curl",
            "Cross-body hammer curl"
          ],
          "alts_ar": [
            "ثني المطرقة بالحبل",
            "ثني المطرقة عبر الجسم"
          ]
        }
      ]
    },
    {
      "id": "ul-d",
      "name": "Lower B",
      "name_ar": "سفلي ب",
      "short": "Lower",
      "short_ar": "سفلي",
      "exercises": [
        {
