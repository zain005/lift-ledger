            "الصعود على الصندوق"
          ]
        },
        {
          "id": "ul-d4",
          "ref": "lying-leg-curl",
          "name": "Lying Leg Curl",
          "sets": 2,
          "reps": "10–12",
          "type": "isolation",
          "cue": "Keep your hips pressed into the pad and curl through the full range.",
          "alts": [
            "Seated leg curl",
            "Nordic ham curl"
          ],
          "alts_ar": [
            "ثني الأرجل جالسًا",
            "الثني النوردي"
          ]
        },
        {
          "id": "ul-d5",
          "ref": "seated-calf-raise",
          "name": "Seated Calf Raise",
          "sets": 3,
          "reps": "12–15",
          "type": "isolation",
          "cue": "Let your heels sink fully, pause, then press all the way up.",
          "alts": [
            "Standing calf raise",
            "Leg press calf raise"
          ],
          "alts_ar": [
            "رفع السمانة واقفًا",
            "رفع السمانة على جهاز ضغط الأرجل"
